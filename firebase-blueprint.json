{
  "entities": {
    "World": {
      "title": "World",
      "description": "Voxel world containing player position, game mode, generation type, and block edits",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the world"
        },
        "name": {
          "type": "string",
          "description": "The name of the world"
        },
        "creator": {
          "type": "string",
          "description": "The UID of the user who created it"
        },
        "creatorName": {
          "type": "string",
          "description": "Display name of the creator"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "playerPos": {
          "type": "object",
          "description": "The saved coordinates of the player"
        },
        "gameMode": {
          "type": "string",
          "description": "Game mode: creative, survival, or adventure"
        },
        "worldType": {
          "type": "string",
          "description": "World generation style: flat, normal, or edge_farlands"
        },
        "edits": {
          "type": "object",
          "description": "Record of coordinate keys and block types"
        },
        "blockColors": {
          "type": "object",
          "description": "Record of coordinate keys and custom hex color strings (#RRGGBB)"
        }
      },
      "required": ["id", "name", "creator", "createdAt", "gameMode", "worldType"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Stores user role permissions and custom biome configuration blocks",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Google email of the user"
        },
        "role": {
          "type": "string",
          "description": "Role: user, staff, mod, owner"
        },
        "biomeSurface": {
          "type": "number",
          "description": "Block type for custom biome surface"
        },
        "biomeUnderground": {
          "type": "number",
          "description": "Block type for custom biome underground"
        },
        "biomeFlora": {
          "type": "number",
          "description": "Block type for custom biome flora/vegetation"
        },
        "vipActive": {
          "type": "boolean",
          "description": "Is VIP active"
        },
        "mvpActive": {
          "type": "boolean",
          "description": "Is MVP+ Supremo active"
        },
        "unlockedWorldsPass": {
          "type": "boolean",
          "description": "Bypasses normal limits"
        },
        "goldCoins": {
          "type": "number",
          "description": "Legacy coin balance"
        },
        "indefCoins": {
          "type": "number",
          "description": "Indef (Minecoin) balance"
        },
        "ownedShopItems": {
          "type": "array",
          "description": "List of purchased VIP shop item IDs"
        },
        "characterSkin": {
          "type": "string",
          "description": "Selected character skin ID"
        },
        "customSkin": {
          "type": "object",
          "description": "Custom 3D character configuration"
        },
        "realmPlan": {
          "type": "string",
          "enum": ["none", "basic", "plus"],
          "description": "Unlocked Realm tier: none, basic (2 friends, 3 worlds), or plus (4 friends, 6 worlds)"
        }
      },
      "required": ["email", "role"]
    },
    "Realm": {
      "title": "Realm",
      "description": "Persistent multiplayer Realm hosting shared worlds with friend and world capacity limits",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Realm ID and join code"
        },
        "joinCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "description": "Shareable invite code for joining the Realm"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Display name of the Realm"
        },
        "tier": {
          "type": "string",
          "enum": ["basic", "plus"],
          "description": "Realm tier: basic (free, 2 friends, 3 worlds) or plus (cheap, 4 friends, 6 worlds)"
        },
        "maxFriends": {
          "type": "number",
          "description": "Maximum friend slots (2 for basic, 4 for plus)"
        },
        "maxWorlds": {
          "type": "number",
          "description": "Maximum shared worlds in the Realm (3 for basic, 6 for plus)"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the Realm owner"
        },
        "ownerEmail": {
          "type": "string",
          "maxLength": 128,
          "description": "Lowercase Google email of the Realm owner"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 128,
          "description": "Display name of the Realm owner"
        },
        "invitedEmails": {
          "type": "array",
          "description": "Bounded list of invited friend emails"
        },
        "memberEmails": {
          "type": "array",
          "description": "Bounded list of joined member emails"
        },
        "worldIds": {
          "type": "array",
          "description": "Bounded list of world IDs hosted inside this Realm"
        },
        "worldsMeta": {
          "type": "array",
          "description": "Lightweight metadata summaries for worlds inside this Realm"
        },
        "activeWorldId": {
          "type": "string",
          "maxLength": 128,
          "description": "Currently highlighted world ID inside the Realm"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last modification timestamp in milliseconds"
        }
      },
      "required": ["id", "joinCode", "name", "tier", "maxFriends", "maxWorlds", "ownerUid", "ownerEmail", "createdAt", "updatedAt"]
    },
    "UserPurchase": {
      "title": "UserPurchase",
      "description": "Information about a successful real purchase of Premium or Coin items",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "productName": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "paymentMethod": {
          "type": "string"
        },
        "indefAmount": {
          "type": "number"
        },
        "timestamp": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "giftedBy": {
          "type": "string",
          "description": "Email of the owner who gifted this item, if gifted"
        },
        "giftNote": {
          "type": "string",
          "description": "Optional personalized message from the owner"
        }
      },
      "required": ["id", "email", "productId", "price", "timestamp"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Auditing activity log of users performing operations, synced to staff",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "playerEmail": {
          "type": "string",
          "description": "Email of the player"
        },
        "playerName": {
          "type": "string",
          "description": "DisplayName of the player"
        },
        "action": {
          "type": "string",
          "description": "Text describing the edit or interaction"
        },
        "timestamp": {
          "type": "number",
          "description": "Activity timestamp"
        }
      },
      "required": ["id", "playerEmail", "playerName", "action", "timestamp"]
    },
    "ActivePlayer": {
      "title": "ActivePlayer",
      "description": "A player currently in a real-time multiplayer world session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID"
        },
        "email": {
          "type": "string",
          "description": "Google email"
        },
        "name": {
          "type": "string",
          "description": "Display name"
        },
        "pos": {
          "type": "object",
          "description": "Position vector {x, y, z}"
        },
        "yaw": {
          "type": "number",
          "description": "Horizontal look rotation in radians"
        },
        "pitch": {
          "type": "number",
          "description": "Vertical look pitch in radians"
        },
        "skinId": {
          "type": "string",
          "description": "Selected 3D character skin preset ID"
        },
        "customSkin": {
          "type": "object",
          "description": "Custom 3D character appearance object"
        },
        "heldBlock": {
          "type": "number",
          "description": "Block or tool type currently held in hand"
        },
        "attackSeq": {
          "type": "number",
          "description": "Monotonic counter triggered on melee swing"
        },
        "lastActive": {
          "type": "number",
          "description": "Heartbeat timestamp"
        },
        "dimension": {
          "type": "string",
          "description": "Dimension: overworld or nether"
        }
      },
      "required": ["id", "email", "name", "pos", "lastActive"]
    },
    "WorldMessage": {
      "title": "WorldMessage",
      "description": "Real-time multiplayer chat message inside a world",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message identifier"
        },
        "senderId": {
          "type": "string",
          "description": "Sender UID or guest session ID"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of sender"
        },
        "text": {
          "type": "string",
          "description": "Chat message content"
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp in milliseconds"
        }
      },
      "required": ["id", "senderId", "senderName", "text", "timestamp"]
    }
  },
  "firestore": {
    "/worlds/{worldId}": {
      "schema": "World",
      "description": "Collection of user-created voxel worlds"
    },
    "/realms/{realmId}": {
      "schema": "Realm",
      "description": "Collection of player-owned multiplayer Realms with friend and world capacity limits"
    },
    "/user_roles/{email}": {
      "schema": "UserRole",
      "description": "Stores role-based permissions and custom biome parameters"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "History of block edits and commands for staff tracking"
    },
    "/worlds/{worldId}/players/{userId}": {
      "schema": "ActivePlayer",
      "description": "Subcollection tracking active multiplayer connections"
    },
    "/worlds/{worldId}/messages/{messageId}": {
      "schema": "WorldMessage",
      "description": "Subcollection storing real-time multiplayer chat messages for a world"
    },
    "/user_purchases/{purchaseId}": {
      "schema": "UserPurchase",
      "description": "Collection storing successful premium or coin purchases"
    }
  }
}
