{
  "entities": {
    "World": {
      "title": "World",
      "description": "Voxel world containing player position, game mode, generation type, and block edits",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the world"
        },
        "name": {
          "type": "string",
          "description": "The name of the world"
        },
        "creator": {
          "type": "string",
          "description": "The UID of the user who created it"
        },
        "creatorName": {
          "type": "string",
          "description": "Display name of the creator"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "playerPos": {
          "type": "object",
          "description": "The saved coordinates of the player"
        },
        "gameMode": {
          "type": "string",
          "description": "Game mode: creative, survival, or adventure"
        },
        "worldType": {
          "type": "string",
          "description": "World generation style: flat, normal, or edge_farlands"
        },
        "edits": {
          "type": "object",
          "description": "Record of coordinate keys and block types"
        }
      },
      "required": ["id", "name", "creator", "createdAt", "gameMode", "worldType"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Stores user role permissions and custom biome configuration blocks",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Google email of the user"
        },
        "role": {
          "type": "string",
          "description": "Role: user, staff, mod, owner"
        },
        "biomeSurface": {
          "type": "number",
          "description": "Block type for custom biome surface"
        },
        "biomeUnderground": {
          "type": "number",
          "description": "Block type for custom biome underground"
        },
        "biomeFlora": {
          "type": "number",
          "description": "Block type for custom biome flora/vegetation"
        },
        "vipActive": {
          "type": "boolean",
          "description": "Is VIP active"
        },
        "unlockedWorldsPass": {
          "type": "boolean",
          "description": "Bypasses normal limits"
        },
        "goldCoins": {
          "type": "number",
          "description": "Amount of purchased gold coins"
        }
      },
      "required": ["email", "role"]
    },
    "UserPurchase": {
      "title": "UserPurchase",
      "description": "Information about a successful real purchase of Premium or Coin items",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "productId": {
          "type": "string"
        },
        "productName": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "timestamp": {
          "type": "number"
        },
        "status": {
          "type": "string"
        }
      },
      "required": ["id", "email", "productId", "price", "timestamp"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Auditing activity log of users performing operations, synced to staff",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "playerEmail": {
          "type": "string",
          "description": "Email of the player"
        },
        "playerName": {
          "type": "string",
          "description": "DisplayName of the player"
        },
        "action": {
          "type": "string",
          "description": "Text describing the edit or interaction"
        },
        "timestamp": {
          "type": "number",
          "description": "Activity timestamp"
        }
      },
      "required": ["id", "playerEmail", "playerName", "action", "timestamp"]
    },
    "ActivePlayer": {
      "title": "ActivePlayer",
      "description": "A player currently in a real-time multiplayer world session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID"
        },
        "email": {
          "type": "string",
          "description": "Google email"
        },
        "name": {
          "type": "string",
          "description": "Display name"
        },
        "pos": {
          "type": "object",
          "description": "Position vector {x, y, z}"
        },
        "lastActive": {
          "type": "number",
          "description": "Heartbeat timestamp"
        },
        "dimension": {
          "type": "string",
          "description": "Dimension: overworld or nether"
        }
      },
      "required": ["id", "email", "name", "pos", "lastActive"]
    }
  },
  "firestore": {
    "/worlds/{worldId}": {
      "schema": "World",
      "description": "Collection of user-created voxel worlds"
    },
    "/user_roles/{email}": {
      "schema": "UserRole",
      "description": "Stores role-based permissions and custom biome parameters"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "History of block edits and commands for staff tracking"
    },
    "/worlds/{worldId}/players/{userId}": {
      "schema": "ActivePlayer",
      "description": "Subcollection tracking active multiplayer connections"
    },
    "/user_purchases/{purchaseId}": {
      "schema": "UserPurchase",
      "description": "Collection storing successful premium or coin purchases"
    }
  }
}
